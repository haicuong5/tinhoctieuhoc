# ==============================================================================
# HỆ THỐNG TIN HỌC TIỂU HỌC ỨNG DỤNG AI (LỚP 3, 4, 5) - CẤU HÌNH BIẾN MÔI TRƯỜNG
# ==============================================================================

# 1. CẤU HÌNH AI STUDIO & GEMINI API (Bắt buộc cho AI sinh bài học)
# Khóa API Gemini từ Google AI Studio (tự động tiêm khi chạy trên AI Studio Build)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. CẤU HÌNH ỨNG DỤNG WEB & MÁY CHỦ
APP_URL="MY_APP_URL"
PORT=3000

# 3. CẤU HÌNH XÁC THỰC QUẢN TRỊ VIÊN HỆ THỐNG
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Tp@2026"

# 4. CẤU HÌNH FIREBASE CLIENT SDK (Dành cho giao diện trình duyệt React Vite)
# Lấy từ Firebase Console -> Project Settings -> General -> Your apps (Web app)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="tinhoctieuhoc-XXXXX.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tinhoctieuhoc-XXXXX"
VITE_FIREBASE_STORAGE_BUCKET="tinhoctieuhoc-XXXXX.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# 5. CẤU HÌNH CLOUD RUN VÀ FIREBASE ADMIN SDK (Phía máy chủ Backend)
# Trên Google Cloud Run: KHÔNG CẦN tệp khóa JSON hay private key!
# Chỉ cần chỉ định Project ID, hệ thống tự động nhận diện Service Account qua ADC:
FIREBASE_PROJECT_ID="ai-tin-hoc-tieu-hoc"
ADMIN_EMAIL="haicuong@gmail.com"

# Cấu hình CORS (Cho phép frontend tách biệt nếu có, ví dụ Firebase Hosting):
# ALLOWED_ORIGINS="https://ai-tin-hoc-tieu-hoc.web.app,https://ai-tin-hoc-tieu-hoc.firebaseapp.com"

# Chế độ bảo mật môi trường Production (Tự động vô hiệu hóa toàn bộ token demo):
NODE_ENV="production"
# STRICT_AUTH_MODE="true"

# (Tùy chọn khi tách rời frontend): URL backend Cloud Run
# VITE_API_BASE_URL="https://tinhoc-backend-xxxxx-as.a.run.app"

